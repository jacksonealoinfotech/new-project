# ==============================================================================
# FASTAPI PRODUCTION STARTER TEMPLATE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Safe defaults for local development. In staging and production environments,
# inject all secrets securely via secret managers or deployment pipelines.
# ==============================================================================

# --- Application Settings ---
APP_NAME=FastAPI Production Template
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-insecure-key-to-a-cryptographically-random-64-character-secret-in-production

# --- CORS & Security Headers ---
# Comma-separated list of origins or wildcard in development
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# --- Database Settings ---
# PostgreSQL asyncpg driver for production / staging:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastapi_db
# For SQLite async testing / local without PostgreSQL:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

# --- Redis Settings ---
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_DEFAULT_TTL=300

# --- Authentication & JWT ---
# Algorithm must be strictly allowlisted (e.g., HS256 or RS256)
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=change-this-jwt-secret-in-production-use-a-strong-random-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=fastapi-production-template
JWT_AUDIENCE=fastapi-production-template-users

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_REQUESTS=100
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# --- Idempotency ---
IDEMPOTENCY_EXPIRE_SECONDS=86400

# --- Logging & Observability ---
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Options: console, json
LOG_FORMAT=console

# --- External Services & Outbox Worker ---
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_SECONDS=5
EMAIL_BACKEND=console
