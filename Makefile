.PHONY: help install dev test test-unit test-integration lint format typecheck migrate migration seed docker-up docker-down check clean

help: ## Show this help message
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-20s\033[0m %s\n", $$1, $$2}'

install: ## Install dependencies in editable mode with development tools
	pip install --upgrade pip
	pip install -e ".[dev]"

dev: ## Run development server with auto-reload
	python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload

test: ## Run complete automated test suite
	pytest

test-unit: ## Run unit tests only
	pytest tests/unit

test-integration: ## Run integration tests only
	pytest tests/integration

test-security: ## Run security tests only
	pytest tests/security

lint: ## Run Ruff linter checks
	ruff check .

format: ## Format code with Ruff
	ruff format .
	ruff check --fix .

typecheck: ## Run static type checking with Mypy
	mypy app tests

migrate: ## Run Alembic database migrations up to head
	alembic upgrade head

migration: ## Generate a new autogenerated Alembic migration (Usage: make migration m="add_feature")
	alembic revision --autogenerate -m "$(m)"

seed: ## Seed initial administrator account (Usage: make seed)
	python scripts/seed.py

docker-up: ## Start PostgreSQL, Redis, and App using Docker Compose
	docker compose up -d

docker-down: ## Stop Docker Compose containers
	docker compose down

check: lint typecheck test ## Run full quality verification pipeline (lint, typecheck, tests)

clean: ## Remove caches, build artifacts, and test database files
	rm -rf .pytest_cache .mypy_cache .ruff_cache htmlcov .coverage *.db *.sqlite3 build dist *.egg-info
